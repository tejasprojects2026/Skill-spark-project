{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "skillsparkconsulting.com"
        }
      ],
      "destination": "https://skillsparkconsulting.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.skillsparkconsulting.com"
        }
      ],
      "destination": "https://skillsparkconsulting.in/$1",
      "permanent": true
    }
  ]
}
